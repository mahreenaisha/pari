{
  "name": "pari-backend",
  "version": "0.1.0",
  "description": "Pari: voice-first udhar ledger for Paytm merchants. Express API + CLI client.",
  "private": true,
  "type": "module",
  "bin": {
    "pari": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "pari": "tsx --env-file-if-exists=.env src/cli/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "test": "vitest run",
    "sarvam:hello": "node --env-file=.env scripts/sarvam-hello.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "kysely": "^0.29.7",
    "multer": "^2.5.0",
    "ora": "^9.4.1",
    "paytmchecksum": "^1.5.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sarvamai": "^1.1.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
